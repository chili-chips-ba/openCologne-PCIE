        <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Application&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px; color: rgb(102, 102, 102);&quot;&gt;&amp;nbsp;EP/main.c&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- &lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;PIO target:&lt;/b&gt;&lt;/font&gt; answers the host&#39;s requests to BAR0&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- MemWr: store the payload DWORD&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- MemRd: send a CplD with the data&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- &lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Config requests:&lt;/font&gt;&lt;/b&gt; answered by the TL, never reach the firmware&lt;br&gt;- &lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Self-test:&lt;/font&gt;&lt;/b&gt; result marker 0xFACE&lt;/div&gt;&lt;/div&gt;" vertex="1">
