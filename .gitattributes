*.sv    linguist-language=SystemVerilog
*.svh   linguist-language=SystemVerilog
*.v     linguist-language=Verilog

0.doc/** linguist-documentation
*.html  linguist-documentation

# third-party VIP (pcieVHost, rv32 ISS, VProc) and PeakRDL output: kept out of the language stats
5.sim/vip/**                     linguist-vendored
4.build/csr_build/generated-files/** linguist-generated
5.sim/models/rv32/usercode/rv32_cache.*  linguist-vendored
5.sim/models/rv32/usercode/uart.*        linguist-vendored

# simulator file lists, not Fortran
*.f     linguist-detectable=false

# LF in the working copy too, whatever core.autocrlf says
*.sv      text eol=lf
*.svh     text eol=lf
*.v       text eol=lf
*.vh      text eol=lf
# scripts, Makefiles and run configs are read on Linux / WSL, where a CR
# breaks bash and ends up in file names
*.sh      text eol=lf
*.csh     text eol=lf
*.cfg     text eol=lf
Makefile* text eol=lf
5.sim/serdesflow_* text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.tcl     text eol=lf
*.ccf     text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.drawio  text eol=lf
*.bat     text eol=crlf

