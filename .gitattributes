*.sv    linguist-language=SystemVerilog
*.svh   linguist-language=SystemVerilog
*.v     linguist-language=Verilog

0.doc/** linguist-documentation
*.html  linguist-documentation

# LF in the working copy too, whatever core.autocrlf says
*.sv      text eol=lf
*.svh     text eol=lf
*.v       text eol=lf
*.vh      text eol=lf
# scripts, Makefiles and run configs are read on Linux / WSL, where a CR
# breaks bash and ends up in file names
*.sh      text eol=lf
*.csh     text eol=lf
*.cfg     text eol=lf
Makefile* text eol=lf
5.sim/serdesflow_* text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.tcl     text eol=lf
*.ccf     text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.drawio  text eol=lf
*.bat     text eol=crlf

