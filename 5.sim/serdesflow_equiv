#!/bin/bash

set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
MODEL_DIR="${HERE}/../2.rtl/1.phy/2.serdes-model"
REPO_ROOT="$(cd "${HERE}/.." && pwd)"

. "${HERE}/serdes_nda_env.sh"

BUILD="${SERDES_BUILD_DIR}/equiv"

IVL=${IVL:-iverilog}
VVP=${VVP:-vvp}

WITH_REF=0
DUMP=""
CROSS=""
KEEP=0
for arg in "$@"; do
  case "$arg" in
    --ref)   WITH_REF=1 ;;
    --dump)  DUMP="-DDUMP" ;;
    --cross) CROSS="-DCROSS_LINK" ;;
    --keep)  KEEP=1 ;;
    -h|--help)
      echo "usage: $0 [--ref] [--cross] [--dump] [--keep]"
      exit 0 ;;
    *) echo "unknown option: $arg"; exit 1 ;;
  esac
done

guard_repo_clean "${REPO_ROOT}"

cleanup () {
  if [ "${KEEP}" = "0" ] && [ -d "${BUILD}/serdes_ref" ]; then
    rm -rf "${BUILD}/serdes_ref"
  fi
}
trap cleanup EXIT INT TERM

mkdir -p "${BUILD}/sim"
rm -f "${BUILD}/equiv.vvp"

DEFS="-DPIPE ${DUMP} ${CROSS}"
REF_SRC=""

if [ "${WITH_REF}" = "1" ]; then
  echo "==> preparing throwaway copy of vendor sources (originals untouched)"
  prepare_vendor_copy "${BUILD}/serdes_ref" || exit 1

  sed -i -E 's/\bmodule[[:space:]]+ccfpga_serdes[[:space:]]*\(/module ccfpga_serdes_ref (/' \
      "${BUILD}/serdes_ref/ccfpga_serdes.v"
  sed -i -E 's/endmodule[[:space:]]*\/\/[[:space:]]*ccfpga_serdes[[:space:]]*$/endmodule \/\/ ccfpga_serdes_ref/' \
      "${BUILD}/serdes_ref/ccfpga_serdes.v"

  if ! grep -q 'module ccfpga_serdes_ref' "${BUILD}/serdes_ref/ccfpga_serdes.v"; then
    echo "ERROR: failed to rename the vendor top module"; exit 1
  fi

  REF_SRC=$(find "${BUILD}/serdes_ref" -type f \( -name '*.v' -o -name '*.sv' \))
  DEFS="${DEFS} -DHAVE_VENDOR_SERDES"
  echo "==> vendor model WILL be compiled in ($(echo "${REF_SRC}" | wc -w) files)"
  echo "    sources : ${CCFPGA_SERDES_SRC}   (read only)"
  echo "    copy    : ${BUILD}/serdes_ref"
  if [ "${KEEP}" = "1" ]; then
    echo "    --keep given: the copy will be LEFT on disk after the run"
  else
    echo "    the copy is deleted when this run ends"
  fi
else
  echo "==> vendor model NOT compiled in; running behavioural self-check only"
fi

echo "==> compiling"
${IVL} -g2012 -gspecify -Ttyp ${DEFS} \
       -I "${MODEL_DIR}" \
       -o "${BUILD}/equiv.vvp" \
       "${MODEL_DIR}/ccfpga_serdes.v" \
       ${REF_SRC} \
       "${HERE}/tb_serdes_equiv.v"

echo "==> running"
cd "${BUILD}"
${VVP} -N equiv.vvp ${DUMP:+-fst}
