# =============================================================================
# Firmware build for the eduBOS5 core inside the EP SOC
#
# Run FROM THIS FOLDER, on Linux or WSL:
#   make                      EP firmware
#
# Flow:  start.S + pcie.c + main.c --gcc--> firmware.elf
#                        --objcopy--> firmware.bin
#                        --python--> firmware.hex
#
# All three outputs land in this folder, or in OUT=<dir>. The hardware build
# consumes firmware.hex --
# riscv_pcie_soc.sv reads it with $readmemh("firmware.hex", ram), one 32-bit
# word per line, hex, no prefix.
#
# The EP needs no start-up delay and so no SIM=1 build: it waits for the
# host's first request, however long link training takes.
# =============================================================================

# ---- CSR register map, generated by PeakRDL (cd .. && make -f MakefileCSR) ----
# csr_regs.h, the accessors on top of it, is source, next to csr.rdl
CSR_DIR    = ../csr_build/generated-files
CSR_CFLAGS = -I$(CSR_DIR) -I../csr_build
CSR_DEPS   = $(CSR_DIR)/csr.h $(CSR_DIR)/csr_top.h ../csr_build/csr_regs.h

# ---- Paths ------------------------------------------------------------------
# Sources live in 3.sw/; this Makefile only builds, it does not hold sources.
# 3.sw/common/ holds start.S, sections.lds and the PCIe request layer
# pcie.c/.h; 3.sw/EP/ holds main.c.
SW_DIR     = ../../3.sw/EP
COMMON_DIR = ../../3.sw/common

# ---- Toolchain --------------------------------------------------------------
# xPack GNU RISC-V Embedded GCC, looked up on PATH; RISCV_PREFIX or CROSS
# override the prefix.
# Override CROSS if the prefix differs, e.g.
#   make CROSS=riscv64-unknown-elf-
RISCV_PREFIX ?= riscv-none-elf-
CROSS        ?= $(RISCV_PREFIX)
CC       = $(CROSS)gcc
OBJCOPY  = $(CROSS)objcopy

PYTHON ?= python3

# ---- Output folder ----------------------------------------------------------
# Default: this folder, where the tracked firmware.hex (the board build) lives.
OUT    ?= .
RM_OUT  = rm -f $(OUT)/firmware.elf $(OUT)/firmware.bin $(OUT)/firmware.hex .build-config

# ---- Flags ------------------------------------------------------------------
# rv32i only -- eduBOS5 is an RV32I core, no M/C extensions.
# -ffreestanding -nostdlib: no libc, no crt0; start.S provides the entry point.
ARCH    = -march=rv32i -mabi=ilp32
CFLAGS  = $(ARCH) -ffreestanding -nostdlib -I$(COMMON_DIR) $(CSR_CFLAGS)
LDFLAGS = -Wl,-Bstatic,-T,$(COMMON_DIR)/sections.lds,--strip-debug

# start.S must come first -- it holds the reset vector.
SRCS = $(COMMON_DIR)/start.S $(COMMON_DIR)/pcie.c $(SW_DIR)/main.c

# The firmware is ALWAYS rebuilt - it takes about a second. make decides what to
# rebuild from file dates alone, and two things defeat that here:
#
#   - a configuration that leaves no trace on disk: change the CSR map
#     and it would compare the same sources against the same outputs, report
#     "Nothing to be done", and leave the PREVIOUS image sitting there;
#   - dates that cannot be trusted: a tree on a network share, or copied off
#     one, can carry timestamps from the future, so a stale firmware.hex looks
#     newer than everything it was built from.
#
# FORCE on firmware.elf closes both, with no bookkeeping to go wrong.
FORCE:

DEPS = $(SRCS) $(COMMON_DIR)/pcie.h $(COMMON_DIR)/sections.lds $(CSR_DEPS) FORCE

# =============================================================================
# TARGETS
# =============================================================================

.PHONY: all clean info help FORCE
.DEFAULT_GOAL := all

all: $(OUT)/firmware.hex

help:
	@echo ================================================================
	@echo  Firmware build -- EP
	@echo ================================================================
	@echo  make                     build firmware.elf + .bin + .hex
	@echo  make info                print the resolved configuration
	@echo  make clean               remove the three generated files
	@echo ================================================================

info:
	@echo OUT     : $(OUT)
	@echo SW_DIR  : $(SW_DIR)
	@echo CC      : $(CC)
	@echo OBJCOPY : $(OBJCOPY)
	@echo PYTHON  : $(PYTHON)
	@echo SOURCES : $(SRCS)

# ---- 1) link ----------------------------------------------------------------
$(OUT)/firmware.elf: $(DEPS)
	@echo ================================================================
	@echo  Compile and link into firmware.elf
	@echo ================================================================
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SRCS)
	@echo OK: $@

# ---- 2) raw binary ----------------------------------------------------------
$(OUT)/firmware.bin: $(OUT)/firmware.elf
	@echo ================================================================
	@echo  objcopy into firmware.bin
	@echo ================================================================
	$(OBJCOPY) -O binary $< $@
	@echo OK: $@

# ---- 3) hex for $readmemh ---------------------------------------------------
# One 32-bit little-endian word per line, 8 hex digits, no 0x prefix -- exactly
# what $readmemh expects.
$(OUT)/firmware.hex: $(OUT)/firmware.bin
	@echo ================================================================
	@echo  bin to hex into firmware.hex
	@echo ================================================================
	$(PYTHON) -c "import struct; f=open('$<','rb'); d=f.read(); f.close(); [print('{:08x}'.format(struct.unpack('<I', d[i:i+4])[0])) for i in range(0, len(d), 4)]" > $@
	@echo ================================================================
	@echo  SUCCESS -- firmware.elf, firmware.bin, firmware.hex
	@echo ================================================================

clean:
	-$(RM_OUT)

# -----------------------------------------------------------------------------
